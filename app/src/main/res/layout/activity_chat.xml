<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="false"
    tools:context=".ChatActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/placeHolderForMaterialCardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#e0f5fe"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardViewProfileBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="0dp"
            android:padding="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="0dp"
            app:contentPadding="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/RoundBottomRight"
            app:strokeColor="#FFFDFD"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="0dp">

                <TextView
                    android:id="@+id/currentUsernameTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-thin"
                    android:text="User's Name"
                    android:textColor="#4D4D4D"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/backBtn" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/profileImage"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginEnd="20dp"
                    android:elevation="5dp"
                    android:scaleType="centerInside"
                    android:background="@color/material_gray"
                    android:src="@drawable/default_image_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/backBtn"
                    app:shapeAppearanceOverlay="@style/CircleImageViewStyle" />

                <ImageButton
                    android:id="@+id/backBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="1dp"
                    android:backgroundTint="#00FFFFFF"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/back_arrow_complete_image" />

                <TextView
                    android:id="@+id/onlineStatusTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="17dp"
                    android:layout_marginBottom="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:text="Offline"
                    android:textColor="#70d0fc"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/currentUsernameTxt" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>


    </androidx.cardview.widget.CardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/placeHolderForChatView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="0dp"
        app:cardBackgroundColor="#e0f5fe"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:contentPadding="0dp"
        app:layout_constraintBottom_toTopOf="@+id/placeHolderForMessageFunction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/placeHolderForMaterialCardview"
        app:shapeAppearanceOverlay="@style/RoundUpperLeft"
        app:strokeWidth="0dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/placeHolderForChatViewConstraintLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/placeHolderForMessageFunction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#e0f5fe"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <EditText
                android:id="@+id/messageBoxTxt"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="32dp"
                android:layout_marginBottom="50dp"
                android:background="@drawable/edittext_circular_background_white"
                android:ems="10"
                android:fontFamily="sans-serif-thin"
                android:hint="Write a message"
                android:inputType="text"
                android:paddingStart="20dp"
                android:textColor="#717171"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendMessageBtn"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_marginRight="5dp"
                android:backgroundTint="#70d0fc"
                app:layout_constraintBottom_toBottomOf="@id/messageBoxTxt"
                app:layout_constraintEnd_toEndOf="@id/messageBoxTxt"
                app:layout_constraintTop_toTopOf="@id/messageBoxTxt"
                tools:layout_editor_absoluteX="370dp"
                tools:layout_editor_absoluteY="71dp" />

            <ImageView
                android:id="@+id/sendIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:layout_constraintBottom_toBottomOf="@id/sendMessageBtn"
                app:layout_constraintEnd_toEndOf="@id/sendMessageBtn"
                app:layout_constraintStart_toStartOf="@id/sendMessageBtn"
                app:layout_constraintTop_toTopOf="@id/sendMessageBtn"
                app:srcCompat="@drawable/send_icon_white" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>